# Card Validation System Environment Variables
# Copy this file to .env and fill in your real values
# Keep .env file permissions at 600 (chmod 600 .env)
#
# Everything is dynamic: change provider, IVR target, cards, timings,
# classification phrases — all from this file. NO code changes needed.

# ========================================
# COMPANY / SYSTEM INFORMATION
# ========================================
COMPANY_NAME=YourCardCompany
SYSTEM_NAME=CardActivationSystem
OPERATED_BY=CardOperationsTeam
CONTACT_EMAIL=operations@yourcompany.com

# ========================================
# PROVIDER (SIP TRUNK) CONFIGURATION + FAILOVER
#
# PROVIDER_ORDER: comma-separated providers, tried in order.
#   When current provider has PROVIDER_FAILOVER_FAILED_CALLS consecutive
#   originate failures, the next provider in the list is auto-selected.
#   Supported names: signalwire, twilio
# ========================================
PROVIDER_ORDER=signalwire
PROVIDER_FAILOVER_FAILED_CALLS=3

# Each provider on Asterisk side corresponds to a SIP endpoint name +
# a caller phone number for outbound CLI.
# If the Asterisk sip.conf/pjsip.conf endpoint name differs from the
# provider name, set PROV_ENDPOINT_OVERRIDE_<name> explicitly.
PROV_ENDPOINT_SIGNALWIRE=signalwire
PROV_CALLERID_SIGNALWIRE=+12082473014

# --- PROVIDER: SIGNALWIRE ---
# NOTE: SignalWire credentials are usually in Asterisk sip.conf (registration),
# not in this file. Setting them here is optional/for future REST-Fallback use.
SIGNALWIRE_ACCOUNT_SID=your_signalwire_space_name
SIGNALWIRE_AUTH_TOKEN=your_signalwire_api_token
SIGNALWIRE_PHONE_NUMBER=your_signalwire_phone_number

# --- PROVIDER: TWILIO (OPTIONAL FALLBACK — leave commented/empty if unused) ---
# To add Twilio as a failover provider: add ",twilio" to PROVIDER_ORDER above,
# then uncomment and fill these three lines + PROV_ENDPOINT_TWILIO + PROV_CALLERID_TWILIO.
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=your_twilio_phone_number
# PROV_ENDPOINT_TWILIO=twilio
# PROV_CALLERID_TWILIO=+12082473014

# ========================================
# IVR PROFILE (per-target-IVR configuration)
#
# IVR_PROFILE_ID selects which IVR we target. One .env = one profile;
# to test multiple IVRs, maintain multiple .env files and switch.
#
# All *_PHRASES vars accept comma-separated substrings (case-insensitive
# match is applied against the transcript).
# ========================================
IVR_PROFILE_ID=default
IVR_PHONE_NUMBER=18003679617

# --- IVR: DTMF / call flow timings (seconds unless *_MS) ---
# These are forwarded to the Asterisk dialplan as channel variables.
# If you need longer for a slow IVR, increase WAIT_AFTER_CARD or CVV.
WAIT_AFTER_CONNECT_S=2
WAIT_AFTER_CARD_DIGITS_S=6
WAIT_AFTER_CVV_DIGITS_S=5
DTMF_DIGIT_ON_MS=100
DTMF_INTER_DIGIT_MS=200
MAX_CALL_WAIT_S=45

# --- IVR: Classification phrases (comma separated, substring match) ---
# Phase 1 after card number entry:
PHRASES_CARD_PROMPT=please enter your 16 digit card number,enter your card number,digit card number
PHRASES_CVV_PROMPT=enter the 3 digit security code,three digit security code,security code,3 digit security code,cvv
PHRASES_INVALID_CARD=card number does not exist,invalid card number,card is invalid,not a valid card number
PHRASES_VERIFICATION_REQUIRED=one time verification code,confirm your identity,text you a code,verification code,send you a text

# Phase 2 after CVV entry (success = valid CVV found -> STOP loop):
PHRASES_VALID_CODE=activated,successful,complete,thank you,your card has been activated,activation complete,card is now active
PHRASES_INVALID_CODE=invalid security code,incorrect security code,wrong code,cvv is incorrect,security code does not match,please try again,code does not match

# ========================================
# CARD INVENTORY
#
# Choose ONE of the following (priority order):
#   1. CARDS_JSON      -> path to a JSON array of card objects
#   2. CARD_NUMBERS_CSV -> comma-separated list of card numbers
#   3. CARD_NUMBER     -> single card (backwards compatibility)
#
# Optional per-card CVV resume: if you know you already tried codes
# 000..start-1 for a given card, set CARD_CVV_START to start there.
# CARDS_JSON format:
#   [ { "number": "4111111111111111", "cvv_start": 120,
#       "expiry_mmyy": "1228", "dob_mmyy": "0998", "phone": "7788379827" }, ... ]
# (expiry / dob / phone are for future Phase 2 flows and are optional today)
# ========================================
CARD_NUMBER=YOUR_REAL_CARD_NUMBER
# CARD_NUMBERS_CSV=4111111111111111,5500000000000004
# CARDS_JSON=/home/ubuntu/ClientIVR/cards.json
CARD_CVV_START=0

# ========================================
# TRANSCRIPTION CONFIGURATION (ELEVENLABS)
# ========================================
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# ========================================
# ASTERISK AMI (required — all calls go through local Asterisk)
# ========================================
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USERNAME=cardvalidator
AMI_SECRET=your_strong_ami_secret

# ========================================
# SYSTEM / RATE LIMITS + CVV BRUTE FORCE
# ========================================
MAX_DAILY_CALLS=100
RATE_LIMIT_CALLS_PER_HOUR=10
CALL_COOLDOWN_SECONDS=30
MAX_SECURITY_ATTEMPTS_PER_CALL=3

# ========================================
# STORAGE CONFIGURATION
# ========================================
RESULTS_DIR=/var/lib/card-validation-system/results
RECORDINGS_DIR=/home/ubuntu/ClientIVR/recordings
STATE_FILE=/var/lib/card-validation-system/state.json
LOG_DIR=/var/log/card-validation-system

# ========================================
# WEB SERVER (read-only status/health endpoints, optional)
# ========================================
WEB_HOST=0.0.0.0
WEB_PORT=5000
PUBLIC_BASE_URL=http://127.0.0.1:5000

# ========================================
# SECURITY CONFIGURATION
# ========================================
MASK_CARD_NUMBERS=true
EMERGENCY_STOP_ON_DETECTION=true
